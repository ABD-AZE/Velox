// Test multilevel pointers (pointer to pointer)
int printf(char* fmt, ...);

int main() {
    int x = 42;
    int* ptr1 = &x;
    int** ptr2 = &ptr1;
    int*** ptr3 = &ptr2;
    
    // Access value through different levels
    printf("Value of x: %d\n", x);
    printf("Value via ptr1: %d\n", *ptr1);
    printf("Value via ptr2: %d\n", **ptr2);
    printf("Value via ptr3: %d\n", ***ptr3);
    
    // Modify through multilevel pointer
    ***ptr3 = 100;
    printf("After ***ptr3 = 100, x = %d\n", x);
    
    // Array of pointers
    int a = 10, b = 20, c = 30;
    int* arr[3];
    arr[0] = &a;
    arr[1] = &b;
    arr[2] = &c;
    
    printf("\nArray of pointers:\n");
    int i;
    for (i = 0; i < 3; i = i + 1) {
        printf("arr[%d] points to value: %d\n", i, *arr[i]);
    }
    
    // Pointer to array of pointers
    int** ptr_to_arr = arr;
    printf("\nAccessing via pointer to array:\n");
    for (i = 0; i < 3; i = i + 1) {
        printf("ptr_to_arr[%d] = %d\n", i, *ptr_to_arr[i]);
    }
    
    return 0;
}
