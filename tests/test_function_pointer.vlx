// Test function pointers
int printf(char* fmt, ...);

// Functions to use with function pointers
int add(int a, int b) {
    return a + b;
}

int subtract(int a, int b) {
    return a - b;
}

int multiply(int a, int b) {
    return a * b;
}

// Function that takes a function pointer as argument
int compute(int a, int b, int (*operation)(int, int)) {
    return operation(a, b);
}

int main() {
    // Declare function pointer
    int (*func_ptr)(int, int);
    
    // Point to add function
    func_ptr = &add;
    printf("Using add: 5 + 3 = %d\n", func_ptr(5, 3));
    
    // Point to subtract function
    func_ptr = &subtract;
    printf("Using subtract: 5 - 3 = %d\n", func_ptr(5, 3));
    
    // Point to multiply function
    func_ptr = &multiply;
    printf("Using multiply: 5 * 3 = %d\n", func_ptr(5, 3));
    
    // Pass function pointer to another function
    printf("\nUsing compute with add: %d\n", compute(10, 5, &add));
    printf("Using compute with subtract: %d\n", compute(10, 5, &subtract));
    printf("Using compute with multiply: %d\n", compute(10, 5, &multiply));
    
    // Array of function pointers
    int (*operations[3])(int, int);
    operations[0] = &add;
    operations[1] = &subtract;
    operations[2] = &multiply;
    
    printf("\nUsing array of function pointers:\n");
    printf("operations[0](8, 2) = %d\n", operations[0](8, 2));
    printf("operations[1](8, 2) = %d\n", operations[1](8, 2));
    printf("operations[2](8, 2) = %d\n", operations[2](8, 2));
    
    return 0;
}
