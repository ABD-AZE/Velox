// File manipulation using system calls - declarations only

// System call declarations 
extern int open(char* pathname, int flags, int mode);
extern int close(int fd);
extern long read(int fd, void* buf, unsigned long count);
extern long write(int fd, void* buf, unsigned long count);
extern long lseek(int fd, long offset, int whence);

// File operation flags
int O_RDONLY = 0;
int O_WRONLY = 1;
int O_RDWR = 2;
int O_CREAT = 64;
int O_TRUNC = 512;

// Seek nts
int SEEK_SET = 0;
int SEEK_CUR = 1;
int SEEK_END = 2;

// Example usage function
int main() {
	char buffer[256];
	int fd = open("example.txt", O_RDWR | O_CREAT, 420);
	
	if (fd < 0) {
		return -1;
	}
	
	write(fd, "Hello, World!\n", 14);
	lseek(fd, 0, SEEK_SET);
	read(fd, buffer, 256);
	close(fd);
	
	return 0;
}
