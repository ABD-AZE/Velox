// Test multi-dimensional arrays
int printf(char* fmt, ...);

int main() {
    // 2D array
    int matrix[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };
    
    printf("2D Array (3x3 matrix):\n");
    int i, j;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            printf("%d ", matrix[i][j]);
        }
        printf("\n");
    }
    
    // Accessing and modifying elements
    matrix[1][1] = 99;
    printf("After modifying matrix[1][1] to 99:\n");
    printf("Center element: %d\n", matrix[1][1]);
    
    // Sum of all elements
    int sum = 0;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            sum = sum + matrix[i][j];
        }
    }
    printf("Sum of all elements: %d\n", sum);
    
    // 3D array
    int cube[2][2][2] = {
        {{1, 2}, {3, 4}},
        {{5, 6}, {7, 8}}
    };
    
    printf("\n3D Array (2x2x2 cube):\n");
    int k;
    for (i = 0; i < 2; i = i + 1) {
        printf("Layer %d:\n", i);
        for (j = 0; j < 2; j = j + 1) {
            for (k = 0; k < 2; k = k + 1) {
                printf("%d ", cube[i][j][k]);
            }
            printf("\n");
        }
    }
    
    return 0;
}
