int main() {
    // Printf itself is a variadic function
    printf("Printf is variadic:\n");
    printf("Integer: %d\n", 42);
    printf("String: %s\n", "Hello");
    printf("Multiple: %d, %d, %d\n", 1, 2, 3);
    printf("Mixed: %s has %d apples\n", "John", 5);
    
    // Note: Full variadic function support requires va_list, va_start, va_arg, va_end
    // which typically come from stdarg.h
    printf("\nVariadic functions require library support (stdarg.h)\n");
    
    return 0;
}
